@echo off
rem MCP-сервер команды для Claude Code (stdio). Вариант для Windows.
rem
rem Каталог, из которого Claude Code запустил сервер, — это каталог рабочего
rem проекта. Запоминаем его ДО перехода в свою папку: по нему команда понимает,
rem в каком пространстве идёт работа, и не пишет заметки в чужой проект.
if "%FLEET_CWD%"=="" set "FLEET_CWD=%CD%"

cd /d "%~dp0"

rem Ключи провайдеров берутся из data\secrets.json (их задают в дашборде), а
rem если их там нет — из переменных окружения пользователя. Вытаскивать их из
rem файла оболочки, как в варианте для macOS, здесь не нужно: на Windows
rem переменные пользователя и так достаются процессу.
".venv\Scripts\python.exe" -m fleet.server
