# Память команды лежит в отдельном приватном репозитории AGENT.Dashboard.DATA,
# склонированном СОСЕДНЕЙ папкой — так он открывается в IDE отдельным проектом,
# а в каталоге инструмента данных нет вообще:
#   git clone git@github.com:<логин>/AGENT.Dashboard.DATA.git ../AGENT.Dashboard.DATA
#
# Путь к нему — свойство машины, поэтому живёт в файле вне git. Каталог data/
# игнорируется ради старых клонов с прежней вложенной раскладкой.
data-path.local
data/

.env
.DS_Store
.idea/
